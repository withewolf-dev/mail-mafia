# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Needed now (reply classifier) ---
# Get one at https://platform.claude.com → API keys
ANTHROPIC_API_KEY=

# --- Sending (outbound lane) ---
# Real sending is OFF unless this is exactly 1. Anything else = dry run.
MAILMAFIA_LIVE=

# SMTP_PASS is an App Password, not your login password:
#   https://myaccount.google.com/apppasswords
# Note: Google Workspace accounts usually CANNOT create app passwords. Auth as
# a personal account that can, and send as the Workspace address via SMTP_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Authenticate as the real mailbox...
SMTP_USER=gitartha@station91.in
# ...but send as this verified alias (Gmail → Settings → Accounts → Send mail as).
# Requires armstrongco.ai to publish Google's SPF record and a DKIM key.
SMTP_FROM=gitartha@armstrongco.ai
SMTP_PASS=
# Must match how the email body signs off, or the name/address mismatch shows.
SMTP_FROM_NAME=Gitartha
# Keep low until the mailbox is warmed. 20/day is a safe starting point.
SMTP_DAILY_CAP=20

# --- Needed later, as each lane gets ported from n8n ---
# Serper — Google Maps harvesting (outbound lane)
SERPER_API_KEY=

# Airtable — prospect + suppression state
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Slack — human-in-the-loop notifications
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#armstrong-leads
