        [{ "node": "Slack — Notify", "type": "main", "index": 0 }],
        [{ "node": "Suppress Domain", "type": "main", "index": 0 }],
        [{ "node": "OOO — Silent Requeue", "type": "main", "index": 0 }],
        [{ "node": "Slack — Notify", "type": "main", "index": 0 }]
      ]
    },
    "Send Booking Link": {
      "main": [[{ "node": "Slack — Notify", "type": "main", "index": 0 }]]
    },
    "Confirm Report": {
      "main": [[{ "node": "Slack — Notify", "type": "main", "index": 0 }]]
    },
    "Suppress Domain": {
      "main": [[{ "node": "Update Status", "type": "main", "index": 0 }]]
    },
    "OOO — Silent Requeue": {
